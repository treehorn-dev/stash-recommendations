{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stash Recommendations Source Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_key", "captured_at", "source_updated_at", "scenes", "performers"],
  "properties": {
    "schema_version": {"const": 1},
    "content_key": {"$ref": "#/$defs/content_key"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_updated_at": {"type": "string", "format": "date-time"},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "performers": {"type": "array", "items": {"$ref": "#/$defs/performer"}}
  },
  "$defs": {
    "content_key": {"type": "object", "additionalProperties": false, "required": ["endpoint", "stash_id"], "properties": {"endpoint": {"type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@]+(?:/[^?#]*)?$"}, "stash_id": {"type": "string", "pattern": ".*\\S.*"}}},
    "https_reference": {"type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@]+(?:/[^?#]*)?$"},
    "scene": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "details": {"type": "string"}, "dates": {"type": "array", "items": {"type": "string", "format": "date"}}, "urls": {"type": "array", "items": {"$ref": "#/$defs/https_reference"}}, "duration": {"type": "integer", "minimum": 0}, "director": {"type": "string"}, "code": {"type": "string"}, "studio": {"$ref": "#/$defs/studio"}, "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}}, "performer_appearances": {"type": "array", "items": {"$ref": "#/$defs/performer_appearance"}}, "remote_images": {"type": "array", "items": {"$ref": "#/$defs/https_reference"}}}},
    "performer": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "gender": {"type": "string"}, "country": {"type": "string"}, "ethnicity": {"type": "string"}, "eye_color": {"type": "string"}, "hair_color": {"type": "string"}, "measurements": {"type": "string"}, "career_years": {"type": "array", "items": {"type": "integer"}}, "urls": {"type": "array", "items": {"$ref": "#/$defs/https_reference"}}, "remote_images": {"type": "array", "items": {"$ref": "#/$defs/https_reference"}}}},
    "studio": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}},
    "tag": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}},
    "performer_appearance": {"type": "object", "additionalProperties": false, "required": ["performer_id"], "properties": {"performer_id": {"type": "string", "minLength": 1}}}
  }
}
